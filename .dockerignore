# ── .dockerignore ─────────────────────────────────────────────────────────────
#
# Works like .gitignore but for Docker builds.
# Files listed here are excluded from the build context sent to the Docker
# daemon. Smaller context = faster builds and a leaner final image.
#

# ── Security: NEVER copy secrets into the image ───────────────────────────────
.env
.env.*

# ── Git history (large, not needed in the image) ──────────────────────────────
.git
.gitignore
.gitattributes

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Django generated directories ──────────────────────────────────────────────
# staticfiles/ is regenerated by collectstatic during the build
# media/ is user-uploaded content — not part of the app image
staticfiles/
media/

# ── Test artifacts ────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ── Docker files (no need to copy these into the image) ───────────────────────
docker-compose.yml
docker-compose.*.yml
.dockerignore

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE folders ───────────────────────────────────────────────────────────────
.vscode/
.idea/

# ── Documentation ─────────────────────────────────────────────────────────────
*.md
README*
